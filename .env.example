# Токен бота от @BotFather
BOT_TOKEN=

# Telegram user id, которым разрешён доступ. Через запятую.
# Свой id можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# Модель по умолчанию (можно менять на лету командой /model)
DEFAULT_MODEL=claude-opus-5

# Необязательно: где держать рабочие папки и состояние
# WORKSPACES_DIR=/home/deploy/bot/workspaces
# DATA_FILE=/home/deploy/bot/data/state.json
